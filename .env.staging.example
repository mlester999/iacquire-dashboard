# Staging environment template. Copy to .env.staging.local (git-ignored) and fill in the staging project's values.
# Never use the production project here. See docs/staging-environment.md.
#
# Run with, for example (ONLY the staging file, never .env: in a checkout that has the production .env that would load production values first,
# so use a separate checkout that has none; first run with --dry-run, which prints "Target: <host>" and applies nothing):
#   node --env-file-if-exists=.env.staging.local --conditions=react-server --import tsx scripts/migrate.ts --dry-run
# or start Next.js with NODE_ENV=development after copying these values into .env.local for one session.

APP_URL=https://staging.iacquire.online
AUTH_PROVIDER=supabase
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres.<staging-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL_CA_FILE=certs/prod-ca-2021.crt
DATABASE_SSL_CA=
# Explicit because development normally refuses a remote database. Remove when finished.
ALLOW_REMOTE_DB_IN_DEV=true

NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging>
SUPABASE_SECRET_KEY=sb_secret_<staging>
SECRET_STORE=vault
APP_ENCRYPTION_KEY=<at-least-32-random-characters-staging-only>
UPLOAD_DIR=.data/staging-uploads

# No customer-facing side effects while staging is being verified. Turn on one provider only after its test account is approved.
EMAIL_PROVIDER=capture
EMAIL_FROM=iAcquire Staging <no-reply@staging.iacquire.online>
RESEND_API_KEY=
RESEND_WRITES_ENABLED=false
TWILIO_WRITES_ENABLED=false
META_WHATSAPP_WRITES_ENABLED=false
GHL_WRITES_ENABLED=false
N8N_ACTIONS_ENABLED=false
CALENDAR_SYNC_DISABLED=true

# Scheduler: keep disabled until a staging-only secret and a supervised run are approved.
CRON_SECRET=
SCHEDULER_ENABLED=false
# When the supervised scheduler test is approved, name the jobs it may run (see docs/unified-inbox/scheduler-impact.md); empty = every job.
SCHEDULER_JOBS_ONLY=
SCHEDULER_STALE_MINUTES=20
# AI workforce features stay off in staging until each is approved; the new Unified Inbox is switched on per workspace from /admin/inbox-rollout.
WORKFORCE_SCHEDULES_ENABLED=false
WORKFORCE_TRIGGERS_ENABLED=false
WORKFORCE_BRIEFINGS_ENABLED=false
INBOX_DISABLED=false
WEBCHAT_PUBLIC_DISABLED=false
WEBCHAT_DAILY_AI_REPLIES=500
PROPOSALS_PUBLIC_DISABLED=false
INVOICES_PUBLIC_DISABLED=false
REVIEWS_PUBLIC_DISABLED=false
DEMO_ENABLED=false
DEMO_PUBLIC_DISABLED=false
# Signed marketing registration (docs/demo-external-registration.md). Off and without a secret until the staging secret is placed in the host; use the staging marketing
# origin, never the production one, and never a real production secret in this file.
DEMO_REGISTRATION_ENABLED=false
DEMO_REGISTRATION_SIGNING_SECRET=
DEMO_REGISTRATION_ALLOWED_ORIGINS=https://staging.iacquire.online
DEMO_REGISTRATION_MAX_SKEW_SECONDS=300
DEMO_VERIFICATION_TTL_HOURS=48
ESIGN_WRITES_ENABLED=false

HELP_LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
SITES_BASE_DOMAIN=sites.staging.iacquire.online
SITES_FORM_SECRET=<staging-only-24-plus-characters>
DEPLOYMENT_ROLE=both
