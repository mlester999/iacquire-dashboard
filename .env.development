# Safe local defaults for `next dev`.
#
# Next.js loads this file in development, after `.env` and before `.env.local`. It keeps a normal `npm run dev` on the embedded
# database with local sign-in, so a manual test can never write to the hosted Supabase project by accident.
#
# To work intentionally against a dedicated remote/staging database, override DATABASE_DRIVER, DATABASE_URL and AUTH_PROVIDER in
# `.env.local` (git-ignored) AND set ALLOW_REMOTE_DB_IN_DEV=true. Never point ordinary development at production.
AUTH_PROVIDER=local
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite-development
APP_URL=http://localhost:3100
DEPLOYMENT_ROLE=both
# Local-only values so a fresh checkout runs without copying production secrets. Never use these outside development.
APP_ENCRYPTION_KEY=local-development-only-key-0123456789abcdef
SITES_FORM_SECRET=local-development-only-form-secret-0123456789

# Local side effects stay off or captured.
EMAIL_PROVIDER=capture
GHL_WRITES_ENABLED=false
RESEND_WRITES_ENABLED=false
TWILIO_WRITES_ENABLED=false
META_WHATSAPP_WRITES_ENABLED=false
N8N_ACTIONS_ENABLED=false
CALENDAR_SYNC_DISABLED=true

# Do not reach the hosted Supabase project or paid providers from ordinary local development. Local sign-in needs none of these.
# Override in .env.local when working against an approved staging project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
LLM_API_KEY=
