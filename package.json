    "studio:qa:build": "node scripts/studio-qa-build.mjs",
    "thumbnails:generate": "node --conditions=react-server --import tsx scripts/generate-template-thumbnails.mjs",
    "studio:qa:editor": "node scripts/studio-editor-browser-qa.mjs",
    "studio:qa:preview-scroll": "node scripts/studio-preview-scroll-qa.mjs",
    "studio:qa:visual": "node scripts/studio-visual-review.mjs",
    "studio:qa:library": "node scripts/studio-library-qa.mjs",
    "studio:qa:text-fit": "node scripts/studio-text-fit-qa.mjs",
    "studio:qa:fresh-seed": "node scripts/run-studio-qa-fresh.mjs",
    "studio:qa:publish-seed": "node scripts/run-studio-qa-publish.mjs",
    "studio:qa:inspect": "node scripts/run-studio-qa-inspect.mjs",
    "studio:qa:published": "node scripts/studio-published-site-qa.mjs",
    "studio:qa:image-text": "node scripts/studio-image-text-qa.mjs",
    "studio:qa:a11y": "node scripts/studio-a11y-qa.mjs",
    "studio:qa:anchors": "node scripts/studio-anchor-qa.mjs",
    "studio:qa:thumbnails": "node scripts/studio-thumbnail-compare.mjs",
    "studio:qa:perf": "node scripts/studio-gallery-perf.mjs",
    "studio:qa:frame-weight": "node scripts/studio-frame-weight.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
