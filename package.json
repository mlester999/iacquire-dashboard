{
  "name": "iacquire-client-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "node scripts/build-clean.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.clean.json && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "db:migrate:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "portfolio:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/import-portfolio.ts",
    "admin:invite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/invite-admin.ts",
    "auth:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate-accounts.ts",
    "mock:hermes": "node --import tsx scripts/mock-hermes.ts",
    "assets:mascots": "node scripts/process-mascots.mjs",
    "workforce:qa": "node scripts/workforce-browser-qa.mjs",
    "workforce:qa:seed": "node scripts/run-workforce-qa-seed.mjs",
    "workforce:qa:server": "node scripts/crm-qa.mjs",
    "hermes:audit": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/hermes-live-audit.ts",
    "workforce:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/workforce-worker.ts",
    "hermes:lead-hunter-audit": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/lead-hunter-readiness-audit.ts",
    "crm:qa": "node scripts/crm-browser-qa.mjs",
    "crm:qa:seed": "node scripts/run-crm-qa-seed.mjs",
    "crm:qa:server": "node scripts/crm-qa.mjs",
    "studio:qa": "node scripts/studio-qa-server.mjs",
    "studio:qa:seed": "node scripts/run-studio-qa-seed.mjs",
