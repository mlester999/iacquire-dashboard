# Copy to a private deployment env file; do not commit filled-in values.
# The base must be the reviewed official Hermes image pinned by immutable digest.
HERMES_BASE_IMAGE=nousresearch/hermes-agent@sha256:REPLACE_WITH_REVIEWED_64_HEX_DIGEST
IACQUIRE_HERMES_IMAGE=iacquire/hermes-client:acceptance
IACQUIRE_PROVISIONER_IMAGE=iacquire/hermes-provisioner:acceptance

# Private host file paths. Files must be owned by UID 10000 and mode 0400/0600.
HERMES_CLIENT_CONFIG_FILE=/srv/iacquire-client-hermes/config.yaml
HERMES_API_KEY_FILE=/srv/iacquire-client-hermes/secrets/hermes-api-key
HERMES_PROFILE_MODEL_ENV_FILE=/srv/iacquire-client-hermes/secrets/profile-model-env.json
IACQUIRE_PROVISIONER_TOKEN_FILE=/srv/iacquire-client-hermes/secrets/provisioner-token

# Non-secret worker routing values. Keep HERMES_PROVISIONER_ENABLED=false in iAcquireOS.
IACQUIRE_PROVISIONER_URL=https://portal.example.invalid
IACQUIRE_PROVISIONER_GATEWAY_ID=00000000-0000-4000-8000-000000000000
