# Placeholders only. Copy to .env.local; enter secrets locally or in secure hosting settings.
# Never paste secrets in the development conversation or commit real values.

# Public base URL used in emails and links.
APP_URL=http://localhost:3000

# Default backend is Supabase; missing configuration fails visibly without a database fallback.
AUTH_PROVIDER=supabase
DATABASE_DRIVER=postgres
DATABASE_URL=
# Download the portal project's root CA from Settings > Database > SSL configuration.
# Production requires verified TLS. Choose a readable CA file path OR the PEM value below.
# The CA certificate is public trust material; the database password and API secret are private.
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CA=
# CA_FILE may be absolute or relative to the app working directory; include it in the deployment.
# CA accepts a PEM certificate with real newlines or literal \n sequences. Never put a private key here.
# Remote development without a CA logs a warning and uses encrypted, unverified TLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Get URL + sb_publishable_... in the Supabase Connect dialog; server sb_secret_... in API Keys.
# DATABASE_URL must use the SAME portal project's direct connection or session pooler with TLS.
# Example: postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Hostinger n8n appointment-event PostgreSQL is separate; never use that database URL here.
# Explicit synthetic local demo, development only: uncomment BOTH overrides below.
# AUTH_PROVIDER=local
# DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite

# Managed Supabase Vault must be enabled in the authorized project for new integration secrets.
SECRET_STORE=vault
ALLOW_LEGACY_CREDENTIAL_READS=false
# Legacy decryption / audit IP hashing keys stay in server secrets, separate from the database.
# Rotate legacy credentials into Vault; production never silently decrypts old records.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_PREVIOUS=
# Approved Hermes/n8n HTTPS hostnames, comma-separated. Never use raw local VPS addresses.
INTEGRATION_ALLOWED_HOSTS=

# Local demo upload path only; Supabase mode uses private Storage buckets.
UPLOAD_DIR=.data/uploads

# Email. "capture" stores messages in the outbox (viewable at /dev/mailbox in development).
EMAIL_PROVIDER=capture
EMAIL_FROM=iAcquire <no-reply@example.com>
RESEND_API_KEY=
# Configure and authorize the provider before migration notices or customer-facing delivery.

# iAcquire Assistant (help widget). Without an LLM it answers from the built-in help center.
HELP_LLM_PROVIDER=none
# HELP_LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional agency alert for new support tickets (in-app inbox always works without it).
SLACK_SUPPORT_WEBHOOK_URL=

# Optional read-only n8n status (never activates workflows).
N8N_BASE_URL=
N8N_API_KEY=

# GoHighLevel API base and write switch. Writes stay disabled until a reviewed sync is approved.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_WRITES_ENABLED=false

# PayMongo (approved payment provider). Server-only; never prefix with NEXT_PUBLIC_.
# sk_test_... = test mode. Live checkout also needs the legal/tax review confirmation in Admin > Billing.
PAYMONGO_SECRET_KEY=
# Signing secret of the webhook endpoint you register once in the PayMongo dashboard (test and live use separate endpoints).
PAYMONGO_WEBHOOK_SECRET=
# payment_method_types enabled on the merchant account (comma-separated). Confirm approved methods before adding more.
PAYMONGO_PAYMENT_METHODS=card
# At least 24 random characters. Authorizes scheduled worker endpoints under /api/internal.
CRON_SECRET=

# Hermes runs: maximum duration before the portal stops a run.
HERMES_RUN_TIMEOUT_MS=180000
# Development only: allow http://localhost Hermes URLs (refused in production).
ALLOW_INSECURE_HERMES_URLS=false
