# Placeholders only. Copy to .env.local; enter secrets locally or in secure hosting settings.
# Never paste secrets in the development conversation or commit real values.

# Public base URL used in emails and links.
APP_URL=http://localhost:3000

# Default backend is Supabase; missing configuration fails visibly without a database fallback.
AUTH_PROVIDER=supabase
DATABASE_DRIVER=postgres
DATABASE_URL=
# Development refuses a remote Postgres database unless this is explicitly true, so `npm run dev` and maintenance scripts cannot
# silently write to production. Use .env.development (embedded PGlite + local sign-in) for ordinary development. Set this only for
# an intentional remote/staging target. Production ignores it.
ALLOW_REMOTE_DB_IN_DEV=false
# Download the portal project's root CA from Settings > Database > SSL configuration.
# Production requires verified TLS. Choose a readable CA file path OR the PEM value below.
# The CA certificate is public trust material; the database password and API secret are private.
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CA=
# CA_FILE may be absolute or relative to the app working directory; include it in the deployment.
# CA accepts a PEM certificate with real newlines or literal \n sequences. Never put a private key here.
# Remote development without a CA logs a warning and uses encrypted, unverified TLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Get URL + sb_publishable_... in the Supabase Connect dialog; server sb_secret_... in API Keys.
# DATABASE_URL must use the SAME portal project's direct connection or session pooler with TLS.
# Example: postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Hostinger n8n appointment-event PostgreSQL is separate; never use that database URL here.
# Explicit synthetic local demo, development only: uncomment BOTH overrides below.
# AUTH_PROVIDER=local
# DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite

# Managed Supabase Vault must be enabled in the authorized project for new integration secrets.
SECRET_STORE=vault
ALLOW_LEGACY_CREDENTIAL_READS=false
# Legacy decryption / audit IP hashing keys stay in server secrets, separate from the database.
# Rotate legacy credentials into Vault; production never silently decrypts old records.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_PREVIOUS=
# Approved Hermes/n8n HTTPS hostnames, comma-separated. Never use raw local VPS addresses.
INTEGRATION_ALLOWED_HOSTS=

# Local demo upload path only; Supabase mode uses private Storage buckets.
UPLOAD_DIR=.data/uploads

# Email. "capture" stores messages in the outbox (viewable at /dev/mailbox in development).
EMAIL_PROVIDER=capture
EMAIL_FROM=iAcquire <no-reply@example.com>
RESEND_API_KEY=
# Configure and authorize the provider before migration notices or customer-facing delivery.

# iAcquire Assistant (help widget). Without an LLM it answers from the built-in help center.
HELP_LLM_PROVIDER=none
# HELP_LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional agency alert for new support tickets (in-app inbox always works without it).
SLACK_SUPPORT_WEBHOOK_URL=

# Optional read-only n8n status (never activates workflows).
N8N_BASE_URL=
N8N_API_KEY=

# GoHighLevel API base and write switch. Writes stay disabled until a reviewed sync is approved.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_WRITES_ENABLED=false

# PayMongo (approved payment provider). Server-only; never prefix with NEXT_PUBLIC_.
# sk_test_... = test mode. Live checkout also needs the legal/tax review confirmation in Admin > Billing.
PAYMONGO_SECRET_KEY=
# Signing secret of the webhook endpoint you register once in the PayMongo dashboard (test and live use separate endpoints).
PAYMONGO_WEBHOOK_SECRET=
# payment_method_types enabled on the merchant account (comma-separated). Confirm approved methods before adding more.
PAYMONGO_PAYMENT_METHODS=card
# At least 24 random characters. Authorizes scheduled worker endpoints under /api/internal.
CRON_SECRET=
# Second, deliberate switch for the scheduled worker. Both CRON_SECRET and SCHEDULER_ENABLED=true are required before any job runs, so
# shipping scheduler configuration cannot start outbound work by itself. Keep false until the scheduler has been reviewed and approved.
SCHEDULER_ENABLED=false
# Minutes without a scheduler heartbeat before the platform opens a "scheduled jobs stopped" incident. Call /api/internal/tick at least this often.
SCHEDULER_STALE_MINUTES=20
# Dedicated AI workforce worker (`npm run workforce:worker`). Off by default. It executes queued ai_work_jobs
# independently of a browser tab, but only when an operator starts the process and sets this to true. The
# scheduler recovery sweep is a separate switch and never runs provider work inside the tick.
WORKFORCE_WORKER_ENABLED=false
WORKFORCE_WORKER_INTERVAL_MS=5000
# Second, deliberate switch for tenant AI workforce schedules. A schedule row must also be enabled.
# Both are required, so deploying a schedule cannot start autonomous work by itself. Keep false until
# a supervised schedule run has been approved.
WORKFORCE_SCHEDULES_ENABLED=false
# Event-driven AI triggers. A trigger row must also be enabled. Both switches are required; keep
# false until a supervised trigger run has been approved.
WORKFORCE_TRIGGERS_ENABLED=false
# Opt-in daily activity briefings and weekly summaries from proactive AI employees. This is a third,
# independent switch: it never creates monitoring work and is off by default. A person must also
# enable their own briefing preference in Settings -> Notifications. Keep false until approved.
WORKFORCE_BRIEFINGS_ENABLED=false
# Automation Studio: days of grace after a recorded payment failure before the plan expires (1 to 30). An agency member can choose another number per case.
STUDIO_PAYMENT_GRACE_DAYS=7
# Permanent deletion of an offboarded client's data. Off by default; keep it off until a backup has been restored once. Even when on, every
# offboarding guard (retention elapsed, billing closed, data downloaded or waived, typed name) still applies.
OFFBOARDING_PURGE_ENABLED=false

# Hermes runs: maximum duration before the portal stops a run.
HERMES_RUN_TIMEOUT_MS=180000
# Development only: allow http://localhost Hermes URLs (refused in production).
ALLOW_INSECURE_HERMES_URLS=false

# Website Studio. Included sites are served at <label>.SITES_BASE_DOMAIN (wildcard DNS and certificate are infrastructure).
SITES_BASE_DOMAIN=sites.iacquire.com
# What customers' own domains should CNAME to (for example cname.sites.iacquire.com).
SITES_CNAME_TARGET=
# portal = authenticated app, sites = public website runtime only (run it as its own deployment), both = local development.
DEPLOYMENT_ROLE=portal
# At least 24 random characters. Signs the spam-control token in site forms. Give the sites deployment its own value.
SITES_FORM_SECRET=
# Optional: where the post-publish health check connects (defaults to https://<host>).
SITES_PROBE_ORIGIN=

# Connected calendars (Native CRM). Registering the OAuth apps: docs/calendar-integrations.md. A provider is offered only when both its ID and secret are set.
# Google Cloud OAuth web client; redirect URI <APP_URL>/api/crm/calendar-oauth/google/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft Entra app registration; redirect URI <APP_URL>/api/crm/calendar-oauth/microsoft/callback.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# common (work, school and personal accounts), organizations, consumers, or one tenant ID.
MICROSOFT_CALENDAR_TENANT=common
# Pauses all calendar busy sync and write-back without disconnecting anyone.
CALENDAR_SYNC_DISABLED=false
# Unified Inbox global emergency switch: true takes the NEW inbox away from every workspace at once (/api/inbox/* and the new-only actions answer "temporarily
# unavailable", its notices stop, and /inbox shows the previous inbox). Receiving and storing messages, the AI employees and every provider switch are not touched.
# Unset or false = each workspace follows its own rollout state: a workspace has the new inbox only after a Super Admin switches it on at /admin/inbox-rollout
# (off by default). docs/unified-inbox/workspace-rollout.md
INBOX_DISABLED=false
# Minutes between reads of Google, Microsoft and CalDAV calendars, and between polls of ICS feeds (which are never instant).
CALENDAR_SYNC_INTERVAL_MINUTES=10
CALENDAR_ICS_POLL_MINUTES=30

# Native messaging (Unified Inbox without GoHighLevel): docs/messaging-providers.md. Each provider has its own kill switch, off by default;
# while it is off nothing is sent through that provider and the message is held with the reason. Per-workspace keys live in the credential vault.
RESEND_WRITES_ENABLED=false
TWILIO_WRITES_ENABLED=false
META_WHATSAPP_WRITES_ENABLED=false
# Resend webhook signing secret (Svix, starts with whsec_) for <APP_URL>/api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Optional: the public origin Twilio calls, when it differs from APP_URL. Twilio signs the exact URL, so this must match it.
TWILIO_WEBHOOK_BASE_URL=
# Meta app secret (signs WhatsApp webhooks, X-Hub-Signature-256) and the verify token you enter when subscribing the webhook.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
