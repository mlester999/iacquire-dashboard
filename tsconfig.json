{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-ui-qa/types/**/*.ts",
    ".next-ui-qa/dev/types/**/*.ts",
    ".next-ui-qa-w/types/**/*.ts",
    ".next-ui-qa-w/dev/types/**/*.ts",
    ".next-sites-qa/types/**/*.ts",
    ".next-sites-qa/dev/types/**/*.ts",
    ".next-studio-premium-qa/types/**/*.ts",
    ".next-studio-premium-qa/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".data",
    "scripts"
  ]
}
